#
# specify the connection string for the database to use 
# format: "{user}:{password}@{hostname}:{port}/{databasename}" 
# default: {root}:{root}@{ssc4framesdb}:{5432}/{ssc4frames} (see docker-compose.yml db service)
#
DB="postgresql+psycopg2://root:root@ssc4framesdb:5432/ssc4frames?application_name=ssc_experiments"

# change the data directory (path is relative to the current file)
# (NOTE: changing this directory is not advised, since third party tools like 'dvc' rely on this path, prefered method is to symlink your preferred directory here)
DATADIR="./data"

# Configure number of concurrent experiment runs
concurrentclusterings.wait.numretry=3
concurrentclusterings.wait.numseconds=3
