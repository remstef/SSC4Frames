// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "ssc4frames",
  "dockerComposeFile": [
		"./docker-compose.yml",
		"../docker-compose.yml"
	],
  "service": "ssc4framesdev",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {
	// 	"ghcr.io/devcontainers/features/common-utils:2": {},
	// 	"ghcr.io/devcontainer-community/devcontainer-features/astral.sh-uv:1": {},
	// 	"ghcr.io/devcontainers/features/docker-in-docker:2": {}
	// },
	// Custom VSCode related settings
	// "customizations": {
  //   "interpreter": {
	// 		"name": "Python", 
	// 		"path": "/usr/local/bin/python"
	// 	}
  // },
	// Uncomment the next line if you want start specific services in your Docker Compose config.
	"runServices": [
		// "pgadmin",
		"db"
	],
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// https://oneuptime.com/blog/post/2026-01-28-dev-container-port-forwarding/view
	"forwardPorts": [
    // "pgadmin:80",      // pgadmin service
		"db:5432"   // PostgreSQL service
  ],
	// Uncomment the next line if you want to keep your containers running after VS Code shuts down.
	// "shutdownAction": "none",
	"shutdownAction": "stopCompose",
	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "sudo apt-get update && sudo apt-get install -y iputils-ping postgresql-client && export UV_LINK_MODE=copy && python -m pip install --upgrade --user pip uv && { [ ! -d .venv ] && {  echo 'creating virtual environment (.venv folder does not exist)' && uv venv; } || { echo 'using existing virtual environment (.venv folder exists)' && uv venv --allow-existing; } } && uv pip install --torch-backend=cpu --editable .[torch]",
	// "postCreateCommand": "sudo apt-get update && sudo apt-get install -y iputils-ping && export UV_LINK_MODE=copy && [ ! -d .venv ] && { uv python pin 3.12; uv venv --python 3.12; } && uv pip install --editable .",
	// "postCreateCommand": "export UV_LINK_MODE=copy && python -m pip install --upgrade --user pip uv && [ ! -d \".venv\" ] && { uv python pin 3.12; uv venv --python 3.12; } && uv pip install --link-mode=copy -r requirements.txt",
	// "postCreateCommand": "export UV_LINK_MODE=copy && python -m pip install --upgrade --user pip uv && [ ! -d \".venv\" ] && { uv python pin 3.12; uv venv --python 3.12; } && uv pip install --editable .",
	// "postCreateCommand": "[ ! -d \".venv\" ] && { uv python pin 3.12; uv venv --python 3.12; } && uv pip install --editable .",
	// Configure tool-specific properties.
	// "customizations": {},
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
  // Set environment variables for VS Code and sub-processes
  "remoteEnv": { 
		"UV_LINK_MODE": "copy",
		"UV_TORCH_BACKEND": "cpu"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.black-formatter"
			]
		}
	}
}
